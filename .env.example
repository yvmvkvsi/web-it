# Public origin only. Do not include a path, query, or trailing application route.
VITE_SITE_URL=https://example.com

# Optional public POST endpoint for the example contact form.
# Leave blank until a real server endpoint with validation and abuse protection exists.
VITE_LEAD_ENDPOINT=

# Set to "true" only on the production domain. Any other value keeps the
# deployment out of search results and makes robots.txt disallow crawling.
# Preview and temporary domains must never set this.
VITE_SITE_INDEXABLE=false
