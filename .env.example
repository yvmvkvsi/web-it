# Public origin only. Do not include a path, query, or trailing application route.
VITE_SITE_URL=https://example.com

# Optional public POST endpoint for the sample-request form.
# Leave blank until a real server endpoint exists that validates input
# independently, rejects the honeypot field and rate-limits by request.
# While blank the form refuses to submit and says so, rather than discarding
# what a visitor typed. See PENDING_DECISIONS P-003.
VITE_LEAD_ENDPOINT=

# Set to "true" only on the confirmed production domain. Any other value —
# including a missing one — keeps the deployment out of search results and
# makes robots.txt disallow crawling. Preview and temporary domains must
# never set this. See SOURCE_OF_TRUTH section 6, "Indexability contract".
VITE_SITE_INDEXABLE=false
